{
    "name": "risetechapps/code-generate",
    "description": "Generate sequential codes for Laravel Eloquent models with support for prefixes, reset patterns, and multiple database drivers",
    "keywords": [
        "risetechapps",
        "Rise Tech",
        "code-generate",
        "sequential-code",
        "laravel",
        "eloquent",
        "mysql",
        "postgresql",
        "sqlserver"
    ],
    "homepage": "https://github.com/risetechapps/code-generate",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Rise Tech",
            "email": "apps@risetech.combr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "RiseTechApps\\CodeGenerate\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RiseTechApps\\CodeGenerate\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"

    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "RiseTechApps\\CodeGenerate\\CodeGenerateServiceProvider"
            ],
            "aliases": {
                "CodeGenerate": "RiseTechApps\\CodeGenerate\\CodeGenerateFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "2.0.0"
}
